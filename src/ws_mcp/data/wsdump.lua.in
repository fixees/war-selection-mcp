-- wsdump: dump of the War Selection Lua API tree for war-selection-mcp (import_api_dump).
-- Generated by war-selection-mcp @@VERSION@@. Read-only: indexes fields, never calls f_* functions.
-- Output goes through log() into gen/log.txt. Every line starts with WSDUMP<TAB><id><TAB>.
local CFG = @@CFG@@
local SEEDS = @@SEEDS@@
local function wsdump(startPath)
local cfg = CFG
local path0 = startPath or cfg.root
local buf, nbuf = {}, 0
local count, rawCount, truncated = 0, 0, false
local expanded, emitted = {}, {}
local seenObj = setmetatable({}, { __mode = "k" })
local function flush()
if nbuf > 0 then log(table.concat(buf, "\n")) end
buf, nbuf = {}, 0
end
local function emit(s)
nbuf = nbuf + 1
buf[nbuf] = "WSDUMP\t" .. cfg.id .. "\t" .. s
if nbuf >= cfg.batch then flush() end
end
local function esc(v)
local s = tostring(v)
if #s > cfg.maxValue then s = string.sub(s, 1, cfg.maxValue) .. "..." end
s = string.gsub(s, "\\", "\\\\")
s = string.gsub(s, "\t", "\\t")
s = string.gsub(s, "\r", "\\r")
s = string.gsub(s, "\n", "\\n")
return s
end
local function get(obj, k)
return pcall(function() return obj[k] end)
end
local function arrayInfo(v)
local t = type(v)
if t ~= "table" and t ~= "userdata" then return false, 0 end
local ok, sz = get(v, "size")
if not ok or type(sz) ~= "number" then return false, 0 end
if sz == 0 then return true, 0 end
local ok0, e0 = get(v, 0)
if ok0 and e0 ~= nil then return true, sz end
return false, 0
end
local function classify(v)
local t = type(v)
if t == "number" then return "num", v end
if t == "string" then return "str", v end
if t == "boolean" then return "bool", tostring(v) end
if t == "function" then return "func", "" end
if t == "nil" then return "nil", "" end
if t == "table" or t == "userdata" then
local isArr, sz = arrayInfo(v)
if isArr then return "arr", sz end
return "obj", ""
end
return t, ""
end
local function toTableAllowed(npath)
if not cfg.toTable then return false end
if not string.find(npath, "[]", 1, true) then return false end
for _, p in ipairs(cfg.toTableSkip) do
if string.sub(npath, 1, #p) == p then return false end
end
return true
end
local function enumKeys(v, npath)
local keys, seen = {}, {}
local function add(k)
if (type(k) == "string" or type(k) == "number") and not seen[k] then
seen[k] = true
keys[#keys + 1] = k
end
end
pcall(function() for k in pairs(v) do add(k) end end)
if cfg.tostringKeys and (type(v) ~= "table" or getmetatable(v) ~= nil) then
local okS, str = pcall(tostring, v)
if okS and type(str) == "string" and #str < 1000000 and not string.find(str, "^userdata: [^\n]*$") and not string.find(str, "^table: [^\n]*$") then
for line in string.gmatch(str, "[^\n]+") do
local k = string.match(line, "^%s*([%a_][%w_]*): ")
if k then add(k) end
end
end
end
if toTableAllowed(npath) then
local ok, t = pcall(toTable, v)
if ok and type(t) == "table" then
for k in pairs(t) do add(k) end
end
end
local s = SEEDS[npath]
if s then
for k in string.gmatch(s, "[^,]+") do add(k) end
end
table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
return keys
end
local walk
local function visitChild(cv, cp, depth)
if emitted[cp] then return end
emitted[cp] = true
if count >= cfg.maxNodes then
truncated = true
return
end
count = count + 1
local tp, val = classify(cv)
if (tp == "obj" or tp == "arr") and seenObj[cv] then
emit("N\t" .. cp .. "\tlink\t" .. esc(seenObj[cv]))
return
end
emit("N\t" .. cp .. "\t" .. tp .. "\t" .. esc(val))
if tp == "obj" or tp == "arr" then
seenObj[cv] = cp
local key = string.match(cp, "([%w_]+)[%[%]]*$") or ""
local reps = 0
for seg in string.gmatch(cp, "[^%.%[%]]+") do
if seg == key then reps = reps + 1 end
end
if reps > cfg.maxRepeat then
emit("W\tcycle guard: " .. cp)
elseif depth < cfg.depth then
walk(cv, cp, depth + 1)
end
end
end
walk = function(v, npath, depth)
if expanded[npath] or truncated then return end
expanded[npath] = true
local isArr, size = arrayInfo(v)
emit("X\t" .. npath .. "\t" .. (isArr and "arr" or "obj") .. "\t" .. tostring(size))
if cfg.raw and rawCount < cfg.maxRaw and (not isArr or size <= cfg.rawArrayMax) then
rawCount = rawCount + 1
emit("R\t" .. npath)
flush()
pcall(log, v)
emit("r\t" .. npath)
end
local numericSeen = false
for _, k in ipairs(enumKeys(v, npath)) do
if truncated then return end
local isNum = type(k) == "number" or tonumber(k) ~= nil
if isNum then
numericSeen = true
elseif string.find(k, "^[%a_][%w_]*$") then
local ok, cv = get(v, k)
local cp = npath .. "." .. k
if not ok then
if not emitted[cp] then
emitted[cp] = true
emit("N\t" .. cp .. "\terr\t" .. esc(cv))
end
else
visitChild(cv, cp, depth)
end
end
end
if isArr or numericSeen then
local n = cfg.arraySample
if isArr and size < n then n = size end
for i = 0, n - 1 do
local ok, ev = get(v, i)
if ok and ev ~= nil then
if i == 0 then
visitChild(ev, npath .. "[]", depth)
elseif (type(ev) == "table" or type(ev) == "userdata") and depth < cfg.depth then
expanded[npath .. "[]"] = nil
walk(ev, npath .. "[]", depth + 1)
end
end
end
end
end
local okStart, start = pcall(function()
local obj = root
for seg in string.gmatch(path0, "[^%.]+") do
local name, rest = string.match(seg, "^([^%[]*)(.*)$")
if name ~= "root" and name ~= "" then obj = obj[name] end
for idx in string.gmatch(rest, "%[(%d+)%]") do obj = obj[tonumber(idx)] end
end
return obj
end)
local npath0 = string.gsub(path0, "%[%d+%]", "[]")
local okV, ver = get(root, "version")
local okB, build = get(root, "buildNumber")
emit("B\t" .. cfg.format .. "\t" .. cfg.space .. "\t" .. npath0 .. "\tversion=" .. esc(okV and ver or "") .. ";build=" .. esc(okB and build or "") .. ";depth=" .. cfg.depth .. ";maxNodes=" .. cfg.maxNodes .. ";arraySample=" .. cfg.arraySample .. ";seeds=" .. tostring(cfg.seeds) .. ";toTable=" .. tostring(cfg.toTable))
local status = "ok"
if not okStart or start == nil then
emit("W\tcannot resolve " .. esc(path0) .. ": " .. esc(start))
status = "error"
else
emitted[npath0] = true
if type(start) == "table" or type(start) == "userdata" then seenObj[start] = npath0 end
count = count + 1
local tp, val = classify(start)
emit("N\t" .. npath0 .. "\t" .. tp .. "\t" .. esc(val))
local okW, err = pcall(walk, start, npath0, 0)
if not okW then
emit("W\t" .. esc(err))
status = "error"
elseif truncated then
status = "truncated"
end
end
emit("E\t" .. count .. "\t" .. status .. "\t" .. rawCount)
flush()
return count, status
end
WSDUMP_RUN = wsdump
@@AUTORUN@@
